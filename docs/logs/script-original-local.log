======================================================================
4. OPERACOES DE UPDATE
======================================================================

-- 4.1 updateOne: marcar alertas do usuário 3 como lidos --
matchedCount: 1 | modifiedCount: 1

-- 4.2 updateOne: corrigir quantidade de um registro (recalculo de kg_co2e e nivel_impacto feito na aplicacao, no lugar da TRIGGER 4) --
matchedCount: 1 | modifiedCount: 1 | novo kg_co2e: 10.92

-- 4.3 updateMany: desativar categorias de Escopo 1 com fator > 0.25 (combustão fóssil direta mais intensa) --
matchedCount: 1 | modifiedCount: 1

-- 4.4 updateOne: revisar meta_reducao_kg do usuário 9 (aumento de meta) --
matchedCount: 1 | modifiedCount: 1

-- 4.5 updateOne: adicionar certificação a usuária que não tinha (schema flexível em ação) --
matchedCount: 1 | modifiedCount: 1

