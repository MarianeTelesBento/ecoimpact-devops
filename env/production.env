# Variáveis NÃO secretas do ambiente de produção. A senha (DB_PASSWORD) vem de secret.
COMPOSE_PROJECT_NAME=ecoimpact-production
APP_ENV=production
APP_PORT=8082
DB_NAME=ecoimpact_production
DB_USER=ecoimpact
# Para fins acadêmicos, a carga inicial também é aplicada em produção (é idempotente).
# Em um ambiente real, use SEED_ON_START=false.
SEED_ON_START=true
